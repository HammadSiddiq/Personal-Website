---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  full?: boolean; // full-bleed page (no width container), used by the home page
}

const {
  title = 'Hammad Sid',
  description = 'Hammad Sid, a Unity game developer building mobile and VR games.',
  full = false,
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/games', label: 'Games' },
  { href: '/how-i-work', label: 'How I Work' },
  { href: '/contact', label: 'Contact' },
  { href: '/blog', label: 'Blog' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const fullTitle = title === 'Hammad Sid' ? title : `${title} · Hammad Sid`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const links = {
  email: 'mailto:hammadsid14@gmail.com',
  linkedin: 'https://www.linkedin.com/in/hammadmsiddique/',
  github: 'https://github.com/HammadSiddiq',
  upwork: 'https://www.upwork.com/freelancers/~0189f791d8afe7a799',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#010127" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <header class="absolute inset-x-0 top-0 z-50 border-b border-white/25">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
        <a href="/" class="text-lg font-extrabold tracking-tight">H.S.</a>
        <ul class="hidden gap-7 text-xs font-medium uppercase tracking-wide md:flex">
          {
            nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class:list={['transition-colors hover:text-accent', isActive(n.href) ? 'text-accent' : 'text-text']}
                  aria-current={isActive(n.href) ? 'page' : undefined}
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
        <details class="relative md:hidden">
          <summary class="cursor-pointer list-none text-xs font-medium uppercase tracking-wide">Menu</summary>
          <ul class="absolute right-0 mt-3 w-44 rounded-md border border-border bg-surface p-2 text-xs font-medium uppercase tracking-wide shadow-xl">
            {
              nav.map((n) => (
                <li>
                  <a
                    href={n.href}
                    class:list={['block rounded px-3 py-2 hover:text-accent', isActive(n.href) ? 'text-accent' : 'text-text']}
                  >
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </header>

    <main class:list={[full ? '' : 'mx-auto max-w-6xl px-6 pb-16 pt-32']}>
      <slot />
    </main>

    <footer class="border-t border-white/25">
      <div class="mx-auto grid max-w-6xl gap-6 px-6 py-12 text-xs font-medium uppercase tracking-wide md:grid-cols-3">
        <a class="hover:text-accent" href="/games">Games</a>
        <a class="hover:text-accent md:text-center" href="/contact">About &amp; Contact</a>
        <ul class="flex flex-wrap gap-3 md:justify-end">
          <li><a class="hover:text-accent" href={links.linkedin} rel="noopener">LinkedIn</a></li>
          <li>|</li>
          <li><a class="hover:text-accent" href={links.github} rel="noopener">GitHub</a></li>
          <li>|</li>
          <li><a class="hover:text-accent" href={links.upwork} rel="noopener">Upwork</a></li>
        </ul>
      </div>
      <p class="px-6 pb-8 text-center text-[11px] uppercase tracking-wide text-muted">
        © {new Date().getFullYear()} Hammad Sid
      </p>
    </footer>
  </body>
</html>
