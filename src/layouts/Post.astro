---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="mx-auto max-w-2xl">
    <a href="/blog" class="text-sm text-muted hover:text-white">← All posts</a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">{frontmatter.title}</h1>
    <p class="mt-2 font-mono text-xs text-muted">{date}</p>
    <div class="prose prose-invert mt-8 max-w-none prose-a:text-accent-2">
      <slot />
    </div>
  </article>
</Base>
