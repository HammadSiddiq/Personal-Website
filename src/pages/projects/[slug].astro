---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import { youtubeId } from '../../lib/media';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: p, next } = Astro.props;
const paragraphs = (p.description ?? p.blurb).split(/\n\s*\n/);
const videos = (p.videos ?? []).map((src) => ({ src, yt: youtubeId(src) }));
const hasMedia = videos.length > 0 || p.gallery.length > 0;
---

<Base title={p.title} description={p.blurb}>
  <h1 class="text-5xl font-extrabold md:text-7xl">{p.title}</h1>

  <div class="mt-12 grid gap-12 md:grid-cols-2">
    <div>
      {
        p.play && (
          <a href={p.play} target="_blank" rel="noopener" class="inline-flex items-center gap-3 text-2xl font-extrabold italic text-accent no-underline">
            Try it
            <span class="circle-arrow">→</span>
          </a>
        )
      }
      <p class:list={['text-xs font-medium uppercase tracking-widest text-muted', p.play ? 'mt-5' : '']}>{p.genre}</p>
      <div class="mt-6 max-w-prose space-y-4 text-base leading-relaxed">
        {paragraphs.map((t) => <p>{t}</p>)}
      </div>
    </div>

    <div class="space-y-5">
      {
        videos.map((v) =>
          v.yt ? (
            <div class="aspect-video overflow-hidden rounded-sm">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${v.yt}`}
                title={`${p.title} video`}
                loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                allowfullscreen
              />
            </div>
          ) : (
            <video class="w-full rounded-sm" controls preload="metadata" playsinline src={v.src} />
          ),
        )
      }
      {p.gallery.map((src) => <img src={src} alt={`${p.title} screenshot`} class="w-full rounded-sm" loading="lazy" />)}
      {!hasMedia && <div class="img-placeholder aspect-video w-full rounded-sm" />}
    </div>
  </div>

  {
    projects.length > 1 && (
      <div class="mt-20 border-t border-white/25 pt-10 text-right">
        <a href={`/projects/${next.slug}`} class="inline-flex items-center gap-4 text-3xl font-extrabold italic text-accent">
          Next Project
          <span class="circle-arrow !h-12 !w-12 text-xl">→</span>
        </a>
      </div>
    )
  }
</Base>
