---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Projects" description="Unity projects by Hammad MS: mobile and VR games.">
  <h1 class="text-4xl font-extrabold md:text-5xl">My Portfolio</h1>
  <p class="mt-3 max-w-2xl text-sm text-muted">Unity games and tools I've built. Hit Play to try a game on itch.io.</p>

  <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2">
    {
      projects.map((p) => (
        <article>
          <div class="aspect-video overflow-hidden rounded-sm">
            {p.image ? (
              <img src={p.image} alt={p.title} class="h-full w-full object-cover" loading="lazy" />
            ) : (
              <div class="img-placeholder h-full w-full" />
            )}
          </div>
          <h2 class="mt-4 text-lg font-extrabold italic">{p.title}</h2>
          <p class="mt-1 text-xs font-medium uppercase tracking-widest text-muted">{p.genre}</p>
          <p class="mt-2 text-sm text-text/90">{p.blurb}</p>
          {p.play && (
            <a class="mt-3 inline-block text-sm font-semibold text-accent hover:underline" href={p.play} rel="noopener" target="_blank">
              Play →
            </a>
          )}
        </article>
      ))
    }
  </div>
</Base>
