---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Projects" description="Unity projects by Hammad Sid: mobile and VR games.">
  <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Projects</h1>
  <p class="mt-3 max-w-2xl text-muted">
    Unity games and tools I've built. Hit Play to try a game on itch.io.
  </p>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {
      projects.map((p) => (
        <article class="card flex flex-col">
          <p class="font-mono text-xs text-accent-2">{p.tag}</p>
          <h2 class="mt-2 text-xl font-semibold">{p.title}</h2>
          <p class="mt-2 text-sm text-muted">{p.blurb}</p>
          {p.play && (
            <div class="mt-auto pt-4 text-sm">
              <a class="text-accent-2 hover:underline" href={p.play} rel="noopener" target="_blank">
                Play →
              </a>
            </div>
          )}
        </article>
      ))
    }
  </div>
</Base>
