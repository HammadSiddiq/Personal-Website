---
import Base from '../layouts/Base.astro';

const channels = [
  { label: 'Email', value: 'hammadsid14@gmail.com', href: 'mailto:hammadsid14@gmail.com' },
  { label: 'LinkedIn', value: 'hammadmsiddique', href: 'https://www.linkedin.com/in/hammadmsiddique/' },
  { label: 'GitHub', value: 'HammadSiddiq', href: 'https://github.com/HammadSiddiq' },
  {
    label: 'Upwork',
    value: 'Hire me on Upwork',
    href: 'https://www.upwork.com/freelancers/~0189f791d8afe7a799',
  },
];
---

<Base title="Contact" description="Get in touch with Hammad Sid.">
  <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Contact</h1>
  <p class="mt-3 max-w-2xl text-muted">
    The fastest way to reach me is email. I'm also happy to talk through Upwork.
  </p>

  <ul class="mt-10 grid gap-4 md:grid-cols-2">
    {
      channels.map((c) => (
        <li>
          <a href={c.href} class="card block" rel="noopener">
            <p class="font-mono text-xs text-accent-2">{c.label}</p>
            <p class="mt-1 font-medium">{c.value}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
