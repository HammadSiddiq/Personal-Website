---
import Base from '../layouts/Base.astro';

const steps = [
  ['Scope', 'We agree on what "done" looks like before any code is written: features, platforms (mobile or VR headset), and constraints.'],
  ['Prototype', 'I build the riskiest mechanic first in Unity, so problems show up early and cheaply.'],
  ['Build in Small Steps', 'Regular playable builds, so you can see progress and steer it as we go.'],
  ['Polish & Test', 'Performance, edge cases, and testing on real devices before anything is handed over.'],
  ['Handoff', 'Clean, documented C# code and a build you can run yourself.'],
];
---

<Base title="How I Work" description="How Hammad Sid scopes, builds, and delivers Unity games and VR projects.">
  <h1 class="text-4xl font-extrabold md:text-5xl">How I Work</h1>
  <p class="mt-3 max-w-2xl text-sm text-muted">A simple process that keeps projects predictable.</p>

  <ol class="mt-12 border-t border-white/25">
    {
      steps.map(([t, d], i) => (
        <li class="grid gap-3 border-b border-white/25 py-8 md:grid-cols-[6rem_1fr] md:gap-6">
          <span class="text-3xl font-extrabold italic text-accent">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="text-xl font-extrabold uppercase not-italic">{t}</h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-text/90">{d}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="py-16 text-center">
    <h2 class="text-3xl font-extrabold uppercase md:text-4xl">Have a Game in Mind?</h2>
    <p class="mt-4 text-sm font-medium uppercase tracking-wide">Tell me what you're building and I'll tell you how I'd approach it</p>
    <a href="/contact" class="mt-8 inline-block rounded-full bg-accent px-7 py-2.5 text-xs font-bold uppercase tracking-wide text-bg hover:brightness-110">
      Contact me
    </a>
  </section>
</Base>
