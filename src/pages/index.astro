---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { findImage } from '../lib/img';

const hero = findImage('hero', 'cover');
const latest = projects.find((p) => p.latest) ?? projects[0];
const featured = projects.filter((p) => p.featured && p.slug !== latest?.slug).slice(0, 3);
---

<Base full>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      {
        hero ? (
          <img src={hero} alt="" class="kenburns h-full w-full object-cover opacity-50" />
        ) : (
          <div class="img-placeholder kenburns h-full w-full" />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-b from-bg/40 via-transparent to-bg"></div>
    </div>

    <div class="mx-auto max-w-6xl px-6 pb-16 pt-40 md:pt-56">
      <p class="text-xs font-medium uppercase tracking-widest">Unity Game Developer</p>
      <h1 class="mt-2 text-6xl font-extrabold uppercase leading-none md:text-8xl">Hammad Sid</h1>
      <p class="mt-5 max-w-md text-sm leading-relaxed">
        I build Mobile and VR games in Unity. A game developer making games and Unity tools.
      </p>

      {
        latest && (
          <div class="mt-10 flex max-w-md items-center gap-4">
            <div class="h-20 w-32 shrink-0 overflow-hidden rounded-sm">
              {latest.image ? (
                <img src={latest.image} alt={latest.title} class="h-full w-full object-cover" />
              ) : (
                <div class="img-placeholder h-full w-full" />
              )}
            </div>
            <div class="text-xs">
              <p class="font-bold">My Latest Work</p>
              <p class="mt-1 text-muted">
                {latest.title} | {latest.genre}
              </p>
              <a href={`/games/${latest.slug}`} class="mt-3 inline-flex items-center gap-2 hover:text-accent">
                View game
                <span class="circle-arrow !h-6 !w-6 text-xs">→</span>
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Portfolio -->
  <section class="border-t border-white/25">
    <div class="mx-auto max-w-6xl px-6 py-10">
      <h2 class="text-2xl font-extrabold uppercase">My Games</h2>
    </div>

    {
      featured.map((p, i) => (
        <article class="border-t border-white/25">
          <div class="mx-auto grid max-w-6xl gap-6 px-6 py-10 md:grid-cols-[6rem_1fr]">
            <div class="flex items-start gap-4 md:flex-col md:gap-10">
              <span class="text-3xl font-extrabold italic">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[10px] font-medium uppercase tracking-widest text-muted md:[writing-mode:vertical-rl] md:rotate-180">
                {p.genre}
              </span>
            </div>
            <div>
              <a href={`/games/${p.slug}`} class="block aspect-video overflow-hidden rounded-sm">
                {p.image ? (
                  <img src={p.image} alt={p.title} class="h-full w-full object-cover transition duration-300 hover:scale-[1.02]" loading="lazy" />
                ) : (
                  <div class="img-placeholder h-full w-full" />
                )}
              </a>
              <h3 class="mt-6 flex items-center gap-3 text-2xl font-extrabold italic uppercase">
                <a href={`/games/${p.slug}`} class="inline-flex items-center gap-3">
                  {p.title}
                  <span class="circle-arrow">→</span>
                </a>
              </h3>
              <p class="mt-2 text-xs font-medium uppercase tracking-widest text-muted">Independent</p>
              <p class="mt-4 max-w-xl text-sm leading-relaxed text-text/90">{p.blurb}</p>
              <a
                href={`/games/${p.slug}`}
                class="mt-5 inline-block rounded-full border border-text px-6 py-2 text-xs font-medium transition hover:border-accent hover:text-accent"
              >
                View Game
              </a>
            </div>
          </div>
        </article>
      ))
    }

    <div class="border-t border-white/25">
      <div class="mx-auto max-w-6xl px-6 py-8 text-center">
        <a href="/games" class="text-xl font-extrabold uppercase hover:text-accent">View All Games</a>
      </div>
    </div>
  </section>
</Base>
