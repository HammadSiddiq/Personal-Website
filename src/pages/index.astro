---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured).slice(0, 6);
---

<Base>
  <section class="py-10 md:py-20">
    <p class="font-mono text-sm text-accent-2">Hi, I'm Hammad 👋</p>
    <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight md:text-6xl">
      I build <span class="gradient-text">Mobile and VR games</span><br class="hidden md:block" />
      in Unity.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      I'm a Unity and C# developer making mobile and VR games, along with the Unity tools that make
      them faster to build.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition hover:brightness-110"
      >
        See my work
      </a>
      <a
        href="/contact"
        class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-text transition hover:border-accent"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section class="mt-10">
    <div class="flex items-end justify-between">
      <h2 class="text-xl font-semibold">Featured projects</h2>
      <a href="/projects" class="text-sm text-muted hover:text-white">All projects →</a>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((p) => (
          <article class="card flex flex-col">
            <p class="font-mono text-xs text-accent-2">{p.tag}</p>
            <h3 class="mt-2 text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm text-muted">{p.blurb}</p>
            {p.play && (
              <a
                class="mt-auto pt-4 text-sm text-accent-2 hover:underline"
                href={p.play}
                rel="noopener"
                target="_blank"
              >
                Play →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>
</Base>
