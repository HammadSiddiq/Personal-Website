---
import Base from '../../layouts/Base.astro';

const modules = import.meta.glob('./*.md', { eager: true }) as Record<string, any>;
const posts = Object.entries(modules)
  .map(([file, mod]) => ({
    url: `/blog/${file.replace('./', '').replace('.md', '')}`,
    ...mod.frontmatter,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Base title="Blog" description="Notes on game development, VR, and building things.">
  <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Blog</h1>
  <p class="mt-3 max-w-2xl text-muted">Notes on game development, VR, and building things.</p>

  <ul class="mt-10 space-y-4">
    {
      posts.map((p) => (
        <li>
          <a href={p.url} class="card block">
            <p class="font-mono text-xs text-muted">
              {new Date(p.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </p>
            <h2 class="mt-1 text-lg font-semibold">{p.title}</h2>
            <p class="mt-1 text-sm text-muted">{p.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
